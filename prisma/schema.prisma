// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// UTILISATEURS & RÉFÉRENTIELS
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs Program[] // Les programmes créés par l'utilisateur
  sessions WorkoutSession[] // L'historique des séances réalisées
}

// Le dictionnaire global des exercices (ex: Développé couché, Squat)
model Exercise {
  id          String  @id @default(uuid())
  name        String
  description String?
  bodyPart    String // Ex: 'CHEST', 'BACK', 'LEGS'
  type        String // Ex: 'WEIGHTLIFTING', 'BODYWEIGHT', 'CARDIO'
  measure     String  @default("REPS") // 'REPS' (répétitions) ou 'TIME' (durée: gainage, cardio...)
  weightIncrement Float @default(1) // Progression : kg ajoutés au plafond de reps (2 pour les gros polyarticulaires)

  workoutExercises WorkoutExercise[] // Lié aux programmes (Templates)
  sets             Set[] // Lié aux séances réalisées (Exécutions)
}

// ==========================================
// PARTIE 1 : TEMPLATES (La planification)
// ==========================================

model Program {
  id          String   @id @default(uuid())
  name        String // Ex: "Prise de masse 4 jours"
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts Workout[]
}

model Workout {
  id        String @id @default(uuid())
  name      String // Ex: "Push Day"
  programId String

  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  sessions  WorkoutSession[] // Historique des fois où cette séance spécifique a été jouée
}

model WorkoutExercise {
  id         String @id @default(uuid())
  workoutId  String
  exerciseId String
  order      Int // Ordre dans la séance (ex: 1er exercice)
  maxReps    Int    @default(12) // Progression : plafond de reps avant d'ajouter du poids (configurable)

  workout  Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise      @relation(fields: [exerciseId], references: [id])
  sets     SetTemplate[]
}

model SetTemplate {
  id                String @id @default(uuid())
  workoutExerciseId String
  targetReps        Int? // Objectif de répétitions (ex: 10) — exercices en 'REPS'
  targetDuration    Int? // Objectif de durée en secondes (ex: 45) — exercices en 'TIME'
  targetWeight      Float? // Objectif de poids en kg (ex: 80)
  restTime          Int // Temps de repos APRES la série (en secondes)
  order             Int // Ordre de la série (Série 1, Série 2...)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
}

// ==========================================
// PARTIE 2 : EXÉCUTION (Le tracking réel)
// ==========================================

model WorkoutSession {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  userId    String
  workoutId String? // Optionnel: null si c'est une séance "Free workout" improvisée
  duration  Int? // Durée totale de la séance en secondes

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  sets    Set[]
}

model Set {
  id               String @id @default(uuid())
  workoutSessionId String
  exerciseId       String

  // Ce qui a été réellement soulevé/fait ce jour-là
  reps     Int?
  duration Int? // Durée réelle en secondes — exercices en 'TIME' (gainage, cardio...)
  weight   Float?
  restTime Int // Temps de repos réel pris (en secondes)
  order    Int // Ordre chronologique dans la séance
  success  Boolean @default(true) // La série a-t-elle été réussie (objectif atteint) ?

  session  WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])
}
